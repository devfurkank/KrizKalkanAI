# KrizKalkan AI — ortam değişkenleri örneği
# Kullanım: cp .env.example .env  (.env asla commit edilmez)

KK_ENVIRONMENT=development
KK_DEBUG=true

# --- Veritabanı ---
KK_DATABASE_URL=postgresql+psycopg://krizkalkan:krizkalkan@localhost:5432/krizkalkan

# --- Kuyruk / önbellek ---
KK_REDIS_URL=redis://localhost:6379/0

# --- Nesne depolama (MinIO / S3) ---
KK_S3_ENDPOINT_URL=http://localhost:9000
KK_S3_BUCKET=krizkalkan-media
KK_S3_ACCESS_KEY=krizkalkan
KK_S3_SECRET_KEY=krizkalkan

# --- Model katmanı ---
# off  → hiçbir ağırlık yüklenmez, tüm modüller kural/sözlük yoluna düşer (sunum sigortası)
# on   → models/ dizinindeki ağırlıklar kullanılır; eksikse yine kural yoluna düşülür
KK_MODELS=off
KK_MODEL_DIR=models
KK_MODEL_RUNTIME=auto      # onnx | torch | auto
KK_MODEL_DEVICE=auto       # cpu | mps | cuda | auto
KK_MODEL_THREADS=0         # 0 = kütüphane varsayılanı

# M4 sentetik görüntü detektörlerinin kaynak ağırlıkları (DeepReality deposu).
# Yalnızca `make m4-model` sırasında gerekir; çalışma zamanında kullanılmaz.
KK_DEEPREALITY_DIR=~/Desktop/DeepReality/models

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
