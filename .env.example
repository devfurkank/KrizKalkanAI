# KrizKalkan AI — ortam değişkenleri örneği
# Kullanım: cp .env.example .env  (.env asla commit edilmez)
#
# Bu dosya çalışan yapılandırmanın şablonudur: kopyalandığında sistem gerçek
# model ağırlıklarıyla ayağa kalkar. Değişkenler depo kökünden okunur; komutlar
# (`make demo`, `make dev-api`, `make test`) kökten çalıştırılmalıdır.

KK_ENVIRONMENT=development
KK_DEBUG=true

# --- API ---
# Analiz istek içinde çalışır; Redis/Celery gerekmez. false yapılırsa iş
# kuyruğa devredilir ve aşağıdaki altyapı servisleri gerekir.
KK_INLINE_ANALYSIS=true
# Açılışta demo akışı (rapor 5.1 senaryoları) yüklensin mi?
KK_SEED_ON_STARTUP=true

# --- Model katmanı ---
# on   → models/ dizinindeki ağırlıklar kullanılır; eksik ya da kabul kapısını
#        geçemeyen ağırlıkta o modül kendiliğinden kural yoluna düşer
# off  → hiçbir ağırlık yüklenmez, tüm modüller kural/sözlük yoluna düşer (sunum sigortası)
# Durum kontrolü: make model-durum  (6/6 "hazır" beklenir)
KK_MODELS=on
KK_MODEL_DIR=models
KK_MODEL_RUNTIME=auto      # onnx | torch | auto
KK_MODEL_DEVICE=auto       # cpu | mps | cuda | auto
KK_MODEL_THREADS=0         # 0 = kütüphane varsayılanı

# M4 sentetik görüntü detektörlerinin kaynak ağırlıkları (DeepReality deposu).
# Yalnızca `make m4-model` sırasında gerekir; çalışma zamanında kullanılmaz.
KK_DEEPREALITY_DIR=~/Desktop/DeepReality/models

# --- Altyapı (yalnızca kuyruk yolunda: KK_INLINE_ANALYSIS=false) ---
# `make up` ile başlar. Demo ve bellek içi depo bunları KULLANMAZ.
KK_DATABASE_URL=postgresql+psycopg://krizkalkan:krizkalkan@localhost:5432/krizkalkan
KK_REDIS_URL=redis://localhost:6379/0
KK_S3_ENDPOINT_URL=http://localhost:9000
KK_S3_BUCKET=krizkalkan-media
KK_S3_ACCESS_KEY=krizkalkan
KK_S3_SECRET_KEY=krizkalkan

# --- Web (Next.js) ---
# Next.js yalnızca kendi dizinindeki dosyayı okur: bu satır apps/web/.env.local
# içinde olmalıdır. Burada başvuru için durur.
NEXT_PUBLIC_API_URL=http://localhost:8000
